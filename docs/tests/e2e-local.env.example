# CipherBank E2E harness credentials (lab / emulator only)
#
# Copy to artifacts/e2e-local.env (gitignored) and fill values before running
# scripts/e2e-android.sh or device Facts with E2E_RUN=1.
#
#   cp docs/tests/e2e-local.env.example artifacts/e2e-local.env
#
# Suggested local lab values for CipherBank_API34 debugging are listed in
# docs/tests/e2e-tests.md under "Harness credentials (debug only)".
# Do not commit artifacts/e2e-local.env or journals under artifacts/.

E2E_TEST_PIN=
E2E_TEST_PIN_ALT=
E2E_RECOVERY_PASSWORD=

# Optional: current,backup SHA-256 SPKI (Base64) to stamp a pin-set into the Appium Debug APK.
# Leave unset to skirt (system CAs) until ops publishes the real pair.
# ANDROID_CERT_PINS=
