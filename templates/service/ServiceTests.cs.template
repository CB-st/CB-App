using Moq;
using Xunit;

namespace CipherBank_app.Tests.__FEATURE__;

public sealed class __SERVICE__Tests
{
    [Fact]
    public async Task ExecuteAsync_DelegatesToDependency()
    {
        var dependency = new Mock<I__DEPENDENCY__>(MockBehavior.Strict);
        dependency.Setup(value => value.ExecuteAsync(It.IsAny<CancellationToken>()))
            .Returns(Task.CompletedTask);
        var subject = new __SERVICE__(dependency.Object);

        await subject.ExecuteAsync(CancellationToken.None);

        dependency.Verify(
            value => value.ExecuteAsync(CancellationToken.None),
            Times.Once);
    }
}
