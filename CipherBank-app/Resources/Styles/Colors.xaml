<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============ CipherBank design tokens ============ -->

    <!-- Accent -->
    <Color x:Key="Accent">#2B59FF</Color>
    <Color x:Key="AccentDark">#8FA8FF</Color>
    <Color x:Key="AccentContrast">#FFFFFF</Color>
    <Color x:Key="AccentContrastDark">#0A0E1A</Color>

    <!-- Surfaces -->
    <Color x:Key="Background">#F6F7FB</Color>
    <Color x:Key="BackgroundDark">#0A0E1A</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#151B2E</Color>
    <Color x:Key="SurfaceInset">#F1F3F9</Color>
    <Color x:Key="SurfaceInsetDark">#1E2540</Color>
    <Color x:Key="Hairline">#0F0F172A</Color>
    <Color x:Key="HairlineDark">#14FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F4F6FF</Color>
    <Color x:Key="TextSecondary">#5A6478</Color>
    <Color x:Key="TextSecondaryDark">#9AA3B8</Color>

    <!-- Status -->
    <Color x:Key="Success">#0BA360</Color>
    <Color x:Key="SuccessDark">#2FE39A</Color>
    <Color x:Key="Danger">#DC3545</Color>
    <Color x:Key="DangerDark">#FF7A88</Color>
    <Color x:Key="SuccessSurface">#D9F5E8</Color>
    <Color x:Key="SuccessSurfaceDark">#143829</Color>
    <Color x:Key="DangerSurface">#FBDDE1</Color>
    <Color x:Key="DangerSurfaceDark">#462026</Color>

    <!-- Pills / badges -->
    <Color x:Key="RecommendedPillBackground">#1F2B59FF</Color>
    <Color x:Key="RecommendedPillBackgroundDark">#D7E45A</Color>
    <Color x:Key="RecommendedPillText">#2B59FF</Color>
    <Color x:Key="RecommendedPillTextDark">#0A0E1A</Color>

    <!-- Coin identity (same in both themes) -->
    <Color x:Key="CoinBtc">#F7931A</Color>
    <Color x:Key="CoinEth">#627EEA</Color>
    <Color x:Key="CoinSol">#00D18C</Color>
    <Color x:Key="CoinDefault">#5A6478</Color>

    <!-- Glow backdrop hues -->
    <Color x:Key="GlowPink">#FFD6E8</Color>
    <Color x:Key="GlowPeach">#FFE8D6</Color>
    <Color x:Key="GlowLavender">#E4DEFF</Color>
    <Color x:Key="GlowMagentaDark">#7A1E5C</Color>
    <Color x:Key="GlowIndigoDark">#2A2E8F</Color>

    <!-- ============ Legacy keys, remapped onto the new palette ============ -->
    <!-- Kept while Styles.xaml and DEBUG code-behind migrate to semantic roles. -->

    <Color x:Key="Primary">#2B59FF</Color>
    <Color x:Key="PrimaryDark">#8FA8FF</Color>
    <Color x:Key="PrimaryDarkText">#0A0E1A</Color>
    <Color x:Key="Secondary">#DCE4FF</Color>
    <Color x:Key="SecondaryDarkText">#8FA8FF</Color>
    <Color x:Key="Tertiary">#1B2B6E</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#0A0E1A</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Semantic Colors: Surface -->
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#151B2E</Color>
    <Color x:Key="SurfaceSecondary">#F1F3F9</Color>
    <Color x:Key="SurfaceSecondaryDark">#1E2540</Color>
    <Color x:Key="IconPlaceholderBackground">#EEF1FA</Color>
    <Color x:Key="IconPlaceholderBackgroundDark">#232B4A</Color>

    <!-- Semantic Colors: Warning Banner -->
    <Color x:Key="WarningBackground">#FFF3CD</Color>
    <Color x:Key="WarningBackgroundDark">#3D3200</Color>
    <Color x:Key="WarningStroke">#FFC107</Color>
    <Color x:Key="WarningStrokeDark">#997404</Color>
    <Color x:Key="WarningText">#856404</Color>
    <Color x:Key="WarningTextDark">#FFD54F</Color>

    <!-- Semantic Colors: Button Variants -->
    <Color x:Key="ButtonSecondary">#5A6478</Color>
    <Color x:Key="ButtonSecondaryDark">#3A4258</Color>
    <Color x:Key="ButtonDanger">#DC3545</Color>
    <Color x:Key="ButtonDangerDark">#FF7A88</Color>
    <Color x:Key="ButtonWarning">#FFC107</Color>
    <Color x:Key="ButtonWarningDark">#997404</Color>
    <Color x:Key="QuickAmountBackground">#E9EEFF</Color>
    <Color x:Key="QuickAmountBackgroundDark">#232B4A</Color>
    <Color x:Key="QuickAmountText">#2B59FF</Color>
    <Color x:Key="QuickAmountTextDark">#8FA8FF</Color>

    <!-- Semantic Colors: Other -->
    <Color x:Key="Divider">#E3E7F0</Color>
    <Color x:Key="DividerDark">#2A3252</Color>
    <Color x:Key="DevModeBackground">#FFFDE7</Color>
    <Color x:Key="DevModeBackgroundDark">#3D3200</Color>
    <Color x:Key="EnvironmentBadge">#FF9800</Color>
    <Color x:Key="EnvironmentBadgeDark">#E68900</Color>
    <Color x:Key="DangerText">#DC3545</Color>
    <Color x:Key="DangerTextDark">#FF7A88</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="HairlineBrushDark" Color="{StaticResource HairlineDark}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
