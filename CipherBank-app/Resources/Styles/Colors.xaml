<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      Cora design tokens (design_handoff_cipherbank/starter/src/theme/tokens.ts).
      Dark is the default app chrome; light is opt-in via Profile.
    -->

    <!-- Brand accents (same in both themes) -->
    <Color x:Key="Gold">#F2C14E</Color>
    <Color x:Key="GoldDark">#C9971F</Color>
    <Color x:Key="GoldBusy">#F0D894</Color>
    <Color x:Key="Violet">#7B4DFF</Color>
    <Color x:Key="DeepPurple">#2B1E3E</Color>
    <Color x:Key="Ink">#111318</Color>
    <Color x:Key="InkDeep">#0C0D11</Color>

    <!-- Accent aliases → gold (primary CTA) -->
    <Color x:Key="Accent">#F2C14E</Color>
    <Color x:Key="AccentDark">#C9971F</Color>
    <Color x:Key="AccentContrast">#111318</Color>
    <Color x:Key="AccentContrastDark">#111318</Color>

    <!-- Surfaces: Light / Dark (= canvas / surface) -->
    <Color x:Key="Background">#F7F5F2</Color>
    <Color x:Key="BackgroundDark">#0C0D11</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1A1624</Color>
    <Color x:Key="SurfaceRaised">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedDark">#241E30</Color>
    <Color x:Key="SurfaceInset">#ECEAE6</Color>
    <Color x:Key="SurfaceInsetDark">#2A2438</Color>
    <Color x:Key="Track">#ECEAE6</Color>
    <Color x:Key="TrackDark">#2A2438</Color>
    <Color x:Key="Hairline">#F0EDEA</Color>
    <Color x:Key="HairlineDark">#2E2838</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#111318</Color>
    <Color x:Key="TextPrimaryDark">#F7F5F2</Color>
    <Color x:Key="TextSecondary">#5A5563</Color>
    <Color x:Key="TextSecondaryDark">#C8C2D2</Color>
    <Color x:Key="TextSubtle">#8A8496</Color>
    <Color x:Key="TextSubtleDark">#8A8496</Color>
    <Color x:Key="OnDark">#F7F5F2</Color>
    <Color x:Key="OnDarkMuted">#C8C2D2</Color>
    <Color x:Key="OnDarkSubtle">#B3AAC6</Color>

    <!-- Status -->
    <Color x:Key="Success">#3FA46A</Color>
    <Color x:Key="SuccessDark">#5FCE8F</Color>
    <Color x:Key="Danger">#C0574B</Color>
    <Color x:Key="DangerDark">#E08A7E</Color>
    <Color x:Key="SuccessSurface">#143FA46A</Color>
    <Color x:Key="SuccessSurfaceDark">#243FA46A</Color>
    <Color x:Key="DangerSurface">#14C0574B</Color>
    <Color x:Key="DangerSurfaceDark">#24C0574B</Color>
    <Color x:Key="SuccessText">#2E7D51</Color>
    <Color x:Key="SuccessTextDark">#5FCE8F</Color>

    <!-- Tab bar -->
    <Color x:Key="TabBar">#F7F5F2</Color>
    <Color x:Key="TabBarDark">#0C0D11</Color>
    <Color x:Key="TabBarBorder">#ECECEC</Color>
    <Color x:Key="TabBarBorderDark">#2E2838</Color>

    <!-- Pills / badges -->
    <Color x:Key="RecommendedPillBackground">#33F2C14E</Color>
    <Color x:Key="RecommendedPillBackgroundDark">#33F2C14E</Color>
    <Color x:Key="RecommendedPillText">#111318</Color>
    <Color x:Key="RecommendedPillTextDark">#F2C14E</Color>
    <Color x:Key="GoldPillFill">#33F2C14E</Color>
    <Color x:Key="GhostBorder">#2EFFFFFF</Color>
    <Color x:Key="VioletTint">#127B4DFF</Color>
    <Color x:Key="WelcomeFrame">#1C1430</Color>
    <Color x:Key="WelcomePlaceholder">#8A7FA8</Color>
    <Color x:Key="CoraAvatarWell">#4A3D63</Color>
    <Color x:Key="CoraLine">#E9E4F2</Color>

    <!-- Coin identity -->
    <Color x:Key="CoinBtc">#F7931A</Color>
    <Color x:Key="CoinEth">#627EEA</Color>
    <Color x:Key="CoinSol">#00D18C</Color>
    <Color x:Key="CoinDefault">#8A8496</Color>

    <!-- Glow / welcome atmosphere -->
    <Color x:Key="GlowPink">#FFD6E8</Color>
    <Color x:Key="GlowPeach">#FFE8D6</Color>
    <Color x:Key="GlowLavender">#E4DEFF</Color>
    <Color x:Key="GlowMagentaDark">#7A1E5C</Color>
    <Color x:Key="GlowIndigoDark">#2B1E3E</Color>

    <!-- Legacy keys remapped onto Cora -->
    <Color x:Key="Primary">#F2C14E</Color>
    <Color x:Key="PrimaryDark">#C9971F</Color>
    <Color x:Key="PrimaryDarkText">#111318</Color>
    <Color x:Key="Secondary">#2B1E3E</Color>
    <Color x:Key="SecondaryDarkText">#C8C2D2</Color>
    <Color x:Key="Tertiary">#7B4DFF</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#7B4DFF</Color>
    <Color x:Key="MidnightBlue">#0C0D11</Color>
    <Color x:Key="OffBlack">#0C0D11</Color>

    <Color x:Key="Gray100">#F0EDEA</Color>
    <Color x:Key="Gray200">#ECEAE6</Color>
    <Color x:Key="Gray300">#C8C2D2</Color>
    <Color x:Key="Gray400">#8A8496</Color>
    <Color x:Key="Gray500">#5A5563</Color>
    <Color x:Key="Gray600">#2E2838</Color>
    <Color x:Key="Gray900">#1A1624</Color>
    <Color x:Key="Gray950">#0C0D11</Color>

    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1A1624</Color>
    <Color x:Key="SurfaceSecondary">#ECEAE6</Color>
    <Color x:Key="SurfaceSecondaryDark">#241E30</Color>
    <Color x:Key="IconPlaceholderBackground">#ECEAE6</Color>
    <Color x:Key="IconPlaceholderBackgroundDark">#2A2438</Color>

    <Color x:Key="WarningBackground">#FFF3CD</Color>
    <Color x:Key="WarningBackgroundDark">#3D3200</Color>
    <Color x:Key="WarningStroke">#F2C14E</Color>
    <Color x:Key="WarningStrokeDark">#C9971F</Color>
    <Color x:Key="WarningText">#856404</Color>
    <Color x:Key="WarningTextDark">#F2C14E</Color>

    <Color x:Key="ButtonSecondary">#5A5563</Color>
    <Color x:Key="ButtonSecondaryDark">#2A2438</Color>
    <Color x:Key="ButtonDanger">#C0574B</Color>
    <Color x:Key="ButtonDangerDark">#E08A7E</Color>
    <Color x:Key="ButtonWarning">#F2C14E</Color>
    <Color x:Key="ButtonWarningDark">#C9971F</Color>
    <Color x:Key="QuickAmountBackground">#33F2C14E</Color>
    <Color x:Key="QuickAmountBackgroundDark">#33F2C14E</Color>
    <Color x:Key="QuickAmountText">#111318</Color>
    <Color x:Key="QuickAmountTextDark">#F2C14E</Color>

    <Color x:Key="Divider">#F0EDEA</Color>
    <Color x:Key="DividerDark">#2E2838</Color>
    <Color x:Key="DevModeBackground">#FFFDE7</Color>
    <Color x:Key="DevModeBackgroundDark">#3D3200</Color>
    <Color x:Key="EnvironmentBadge">#F2C14E</Color>
    <Color x:Key="EnvironmentBadgeDark">#C9971F</Color>
    <Color x:Key="DangerText">#C0574B</Color>
    <Color x:Key="DangerTextDark">#E08A7E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
    <SolidColorBrush x:Key="DeepPurpleBrush" Color="{StaticResource DeepPurple}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="HairlineBrushDark" Color="{StaticResource HairlineDark}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
