<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CipherBank_app.Views.SplashPage"
             Title="Splash"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{StaticResource Ink}"
             AutomationId="SplashPage">
  <VerticalStackLayout VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Spacing="20">
    <!-- Static diamond mark — animated FadeTo pulse removed (caused Android cold-start UI-thread spin). -->
    <Grid WidthRequest="64"
          HeightRequest="64"
          HorizontalOptions="Center"
          VerticalOptions="Center">
      <Border WidthRequest="36"
              HeightRequest="36"
              Rotation="45"
              StrokeThickness="2.8"
              Stroke="{StaticResource Gold}"
              BackgroundColor="Transparent"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              StrokeShape="RoundRectangle 6" />
      <Border WidthRequest="18"
              HeightRequest="18"
              Rotation="45"
              StrokeThickness="0"
              BackgroundColor="{StaticResource Violet}"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              StrokeShape="RoundRectangle 3" />
    </Grid>
    <Label x:Name="StatusLabel"
           Text="Securing your session…"
           Style="{StaticResource MonoCaption}"
           CharacterSpacing="1"
           TextColor="{StaticResource OnDarkSubtle}"
           HorizontalTextAlignment="Center"
           AutomationId="SplashStatusLabel" />
  </VerticalStackLayout>
</ContentPage>
