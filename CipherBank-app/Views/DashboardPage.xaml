<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CipherBank_app.ViewModels"
             xmlns:models1="clr-namespace:CipherBank_app.Models;assembly=CipherBank-app.Core"
             x:Class="CipherBank_app.Views.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Dashboard">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshPricesCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,12,20,24" Spacing="16">

                <!-- Header -->
                <Label x:Name="WelcomeLabel"
                       AutomationId="WelcomeLabel"
                       Text="Market Overview"
                       Style="{StaticResource DisplayTitle}"
                       FontSize="28"
                       HorizontalOptions="Start" />

                <Label x:Name="TotalBalanceLabel"
                       AutomationId="TotalBalanceLabel"
                       Text="{Binding TotalPortfolioValue, StringFormat='Portfolio: ${0:N2}'}"
                       Style="{StaticResource PortfolioSummary}"
                       Margin="0,-8,0,4" />

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HeightRequest="50" />

                <!-- Error Message -->
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                        Style="{StaticResource WarningBanner}">
                    <Label x:Name="ErrorLabel"
                           AutomationId="ErrorLabel"
                           Text="{Binding ErrorMessage}"
                           Style="{StaticResource WarningBannerText}" />
                </Border>

                <!-- Cryptocurrency List -->
                <CollectionView x:Name="CryptocurrenciesList"
                               AutomationId="RecentTransactionsList"
                               ItemsSource="{Binding Cryptocurrencies}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedCrypto}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models1:CryptoCurrency">
                            <Border Margin="0,6" Style="{StaticResource CardBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DashboardViewModel}}, Path=ViewCryptoDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SurfaceInsetDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Label Style="{StaticResource WatermarkGlyph}"
                                           Grid.ColumnSpan="3"
                                           FontSize="64"
                                           Text="{Binding Symbol, Converter={StaticResource CoinGlyphConverter}}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           TranslationX="10" />

                                    <!-- Coin icon -->
                                    <Border Style="{StaticResource CoinCircle}"
                                            VerticalOptions="Start"
                                            BackgroundColor="{Binding Symbol, Converter={StaticResource CoinColorConverter}}">
                                        <Label Text="{Binding Symbol, Converter={StaticResource CoinGlyphConverter}}"
                                               Style="{StaticResource CoinGlyph}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Name, symbol, price block -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource TitleMedium}" />
                                        <Label Text="{Binding Symbol}" Style="{StaticResource PillLabel}" />
                                        <Label Text="Current Price" Style="{StaticResource Eyebrow}" Margin="0,6,0,0" />
                                        <Label Text="{Binding FormattedPrice}"
                                               Style="{StaticResource AssetPriceProminent}" />
                                    </VerticalStackLayout>

                                    <!-- 24h change -->
                                    <Label Grid.Column="2"
                                           Text="{Binding FormattedPercentChange}"
                                           Style="{StaticResource PriceChange}"
                                           VerticalOptions="Center"
                                           Margin="0,0,8,0"
                                           TextColor="{Binding IsPriceUp, Converter={StaticResource PriceChangeColorConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="40">
                            <Label Text="No cryptocurrencies available"
                                   FontSize="16"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalTextAlignment="Center" />
                            <Button x:Name="RefreshButton"
                                    AutomationId="RefreshButton"
                                    Text="Refresh"
                                    Command="{Binding LoadPricesCommand}"
                                    Margin="0,20,0,0" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Quick Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            x:Name="PurchaseButton"
                            AutomationId="PurchaseButton"
                            Text="Buy Crypto  →"
                            Command="{Binding NavigateToPurchaseCommand}"
                            HeightRequest="52" />

                    <Button Grid.Column="1"
                            x:Name="WalletButton"
                            AutomationId="WalletButton"
                            Text="My Wallets"
                            Command="{Binding NavigateToWalletsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="52" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
