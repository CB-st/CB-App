<Project>

  <!-- Shared properties for all projects in the solution -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required for IDE0005 (unused usings) during build. See roslyn#41640. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!-- Code Analysis Settings -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- One repository-wide StyleCop configuration; do not add per-project stylecop.json copies. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json"
                     Link="stylecop.json" />
  </ItemGroup>

  <!-- Shared package references for analyzers -->
  <ItemGroup>
    <!-- StyleCop Analyzers for consistent code style -->
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Security analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Security-specific analyzer configuration -->
  <PropertyGroup>
    <!-- Treat security-related warnings as errors -->
    <WarningsAsErrors>$(WarningsAsErrors);CA2100;CA5350;CA5351;CA5359;CA5360;CA5361;CA5362;CA5363;CA5364;CA5365;CA5366;CA5367;CA5368;CA5369;CA5370;CA5371;CA5372;CA5373;CA5374;CA5375;CA5376;CA5377;CA5378;CA5379;CA5380;CA5381;CA5382;CA5383;CA5384;CA5385;CA5386;CA5387;CA5388;CA5389;CA5390;CA5391;CA5392;CA5393;CA5394;CA5395;CA5396;CA5397;CA5398;CA5399;CA5400;CA5401;CA5402;CA5403;CA5404;CA5405</WarningsAsErrors>
  </PropertyGroup>

  <!-- Optional local overlay. Not committed; drop .compliance/ on a machine that needs it. -->
  <Import Project="$(MSBuildThisFileDirectory).compliance/msbuild/Local.Compliance.props"
          Condition="Exists('$(MSBuildThisFileDirectory).compliance/msbuild/Local.Compliance.props')" />
  <Import Project="$(MSBuildThisFileDirectory).compliance/msbuild/DotNet10.Compliance.props"
          Condition="Exists('$(MSBuildThisFileDirectory).compliance/msbuild/DotNet10.Compliance.props')" />

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'CipherBank-app.Analyzers' AND '$(MSBuildProjectName)' != 'CipherBank-app.Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)CipherBank-app.Analyzers\CipherBank-app.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
